<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>togo_status_handler</name>
  <version>0.0.0</version>
  <description>Status handler for Togo, summarizing status information from Clearpath Husky A300 AMP.</description>
  <maintainer email="emily.j.sheetz@nasa.gov">Emily Sheetz</maintainer>
  <license>TODO: License declaration</license>

  <depend>std_msgs</depend>
  <depend>clearpath_platform_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
